# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the Express API, including the /api/v1 prefix.
# IMPORTANT: Use your machine's LAN IP address, not localhost.
# localhost on a physical Android device points at the device, not your machine.
# Example: http://192.168.1.10:3000/api/v1
#
# To find your LAN IP on Windows: run `ipconfig` and look for "IPv4 Address"
# under your active network adapter.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api/v1
