# ─── Database ────────────────────────────────────────────────────────────────
# Supabase connection string with PgBouncer (used by the app at runtime).
# Found at: Supabase dashboard → Settings → Database → Connection string → URI
# (Select "Transaction" mode — it includes ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection (no PgBouncer) — required by Prisma migrate and db push.
# Found at: Supabase dashboard → Settings → Database → Connection string → URI
# (Select "Session" mode — it does NOT include pgbouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ──────────────────────────────────────────────────────────────────
# How many hours a session token remains valid before it is expired.
# Must match the value documented in specs/001-user-login/data-model.md (§4 → 8 h).
SESSION_TTL_HOURS=8
