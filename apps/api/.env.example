# Runtime uses the dedicated oak_api LOGIN, inheriting only oak_runtime.
# Copy host/project details from Supabase Connect. Percent-encode the password once.
# Session pooler (5432) works with the existing IPv4 development setup.
DATABASE_URL="postgresql://oak_api.PROJECT_REF:ENCODED_RUNTIME_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require&connection_limit=5"

# Migration-only privileged session/direct URL. Preserve your working value privately.
# Optional in the runtime deployment; never pass this to request-processing Prisma.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_MIGRATION_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require"

PORT=3000
NODE_ENV=development
# Approved absolute lifetime; other values require a specification decision.
SESSION_TTL_HOURS=8
# Matches the database-enforced policy; defaults to 30 when omitted. Changing the
# policy requires a reviewed migration, not only changing this variable.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Empty means Express trust proxy=false. Only literal, verified upstream proxy IPs
# may be listed, comma-separated. Never use true or an arbitrary hop count.
# T030 wires env.TRUST_PROXY into Express before rate limiting.
TRUST_PROXY_IPS=
